# =======================================================
# SEEAKK CONTROL SOFTWARE ENVIRONMENT CONFIGURATION
# Dedicated database exclusively for Control Software data.
# NEVER connect to SEEAKK Customer/Production/Test DBs.
# =======================================================

# PostgreSQL Database URL for SEEAKK Control Software
DATABASE_URL="postgresql://control_admin:control_password@localhost:5432/seeakk_control_db?schema=public"

# Session / JWT Secret (min 32 characters)
AUTH_SECRET="seeakk-control-super-secret-key-change-in-production-min32chars"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application Environment (development, staging, production)
NODE_ENV="development"

# =======================================================
# SEEAKK SERVER-TO-SERVER INTEGRATION (SERVER-SIDE ONLY)
# Never expose these with NEXT_PUBLIC_ or leak to browser
# =======================================================

# SEEAKK Base API URLs by Environment
SEEAKK_API_BASE_URL_TEST="http://localhost:5000"
SEEAKK_API_BASE_URL_STAGING="https://staging.seeakk.internal"
SEEAKK_API_BASE_URL_PRODUCTION="https://api.seeakk.internal"

# Shared Secret for Authenticating Outbound Calls to SEEAKK Internal Platform API (x-service-key)
SEEAKK_CONTROL_SERVICE_KEY="your-pre-shared-service-key-here"

# HMAC Secret for Inbound Webhook Verification
SEEAKK_WEBHOOK_SECRET="your-pre-shared-webhook-secret-here"

